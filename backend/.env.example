ENVIRONMENT=development
APP_URL=http://localhost:5173
DATABASE_URL=sqlite:///./assistant.db
SECRET_KEY=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173

# Development only. Never enable either flag in production.
DEV_AUTO_VERIFY_EMAIL=true
DEV_OUTBOX_ENABLED=true
DEV_OUTBOX_PATH=./dev-outbox.jsonl

# Production email verification and password reset.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=assistant@example.com
# SMTP_STARTTLS=true

# Optional chat. POST /chat/messages returns 503 without this key.
# GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOOL_CALLS=6

# Optional Evolution API 2.3.7 integration. Keep secrets server-side.
# WHATSAPP_API_URL=https://evolution.example.com
# WHATSAPP_API_KEY=
# WHATSAPP_INSTANCE=pulso
# WHATSAPP_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
WHATSAPP_WORKER_POLL_SECONDS=2

SCHEDULER_POLL_SECONDS=15
